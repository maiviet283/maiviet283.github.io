---
import { Image } from 'astro:assets'
import Icon from './Icon.astro'
import avatar from '../data/images/avatar.png'
import Marquee from './Marquee.astro'
import type { Locale } from '../types'

interface Props {
  text: Locale
}

const { text } = Astro.props
const hero = text.hero
const stickerTones = ['sun', 'mint', 'pink', 'card']
---

<section class="hero dots" id="top">
  <div class="wrap hero-in">
    <div class="copy">
      <p class="hero-eyebrow" data-reveal>
        <span class="live-dot" aria-hidden="true"></span>
        {hero.status}
      </p>
      <h1 data-reveal style="--i: 1">
        <span class="line">Mai Quốc</span>
        <span class="line"><span class="hl">Việt</span></span>
      </h1>
      <p class="hero-lead" data-reveal style="--i: 2">{hero.lead}</p>
      <p class="hero-body" data-reveal style="--i: 3">{hero.body}</p>
      <div class="actions" data-reveal style="--i: 4">
        <a class="btn btn-sun btn-lg" href="#products">
          <Icon name="rocket" />
          {hero.primaryAction}
        </a>
        <a class="btn btn-lg" href="#contact">
          <Icon name="mail" />
          {hero.contactAction}
        </a>
      </div>
    </div>

    <div class="art" data-parallax-root>
      <div class="portrait" data-reveal style="--i: 1">
        <Image
          src={avatar}
          alt={hero.avatarAlt}
          widths={[360, 560, 800]}
          sizes="(min-width: 860px) 460px, 78vw"
          loading="eager"
          fetchpriority="high"
        />
      </div>
      <p class="bubble" data-reveal style="--i: 3">{hero.greeting}</p>
      {hero.stickers.map((sticker, index) => (
        <span
          class:list={['sticker', `s${index + 1}`, `tone-${stickerTones[index % stickerTones.length]}`]}
          data-parallax={String(0.6 + index * 0.35)}
        >
          {sticker}
        </span>
      ))}
    </div>
  </div>

  <Marquee items={text.marquee} />
</section>

<style>
  .hero {
    position: relative;
    border-bottom: var(--line);
    color: #fffaf2;
    overflow: hidden;
  }

  .hero-in {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: clamp(32px, 5vw, 64px);
    align-items: center;
    padding-block: clamp(32px, 7vw, 88px) clamp(40px, 6vw, 72px);
  }

  .hero-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 6px 14px;
    border: var(--line-w) solid #1a1613;
    border-radius: 999px;
    background: #fffaf2;
    color: #1a1613;
    font-size: 14px;
    font-weight: 700;
    box-shadow: 3px 3px 0 #1a1613;
  }

  h1 {
    margin-top: 22px;
    font-size: clamp(76px, 13vw, 168px);
    line-height: 0.86;
    text-shadow: 5px 5px 0 #1a1613;
  }

  h1 .line {
    display: block;
  }

  h1 .hl {
    margin-top: 0.08em;
    padding: 0.02em 0.14em 0;
    border-color: #1a1613;
    box-shadow: 8px 8px 0 #1a1613;
    text-shadow: none;
    border-radius: 14px;
  }

  .hero-lead {
    max-width: 30ch;
    margin-top: 30px;
    font-family: var(--display);
    font-size: clamp(26px, 2.8vw, 34px);
    font-weight: 700;
    line-height: 1.12;
    text-transform: uppercase;
  }

  .hero-body {
    max-width: 52ch;
    margin-top: 14px;
    font-size: 17px;
    color: rgb(255 250 242 / 0.88);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 30px;
  }

  .actions .btn {
    border-color: #1a1613;
    box-shadow: 4px 4px 0 #1a1613;
  }

  .actions .btn:not(.btn-sun) {
    --bg: #fffaf2;
    --fg: #1a1613;
  }

  /* ---------- Art ---------- */
  .art {
    position: relative;
    justify-self: center;
    width: min(100%, 460px);
    aspect-ratio: 1;
  }

  .portrait {
    position: absolute;
    inset: 4%;
  }

  .portrait img {
    width: 100%;
    height: 100%;
    border: 5px solid #1a1613;
    border-radius: 50%;
    object-fit: cover;
    object-position: 50% 20%;
    background: #fffaf2;
    box-shadow: 14px 14px 0 #1a1613;
  }

  @media (prefers-reduced-motion: no-preference) {
    .portrait img {
      animation: bob 5s ease-in-out infinite;
    }
  }

  .bubble {
    position: absolute;
    top: -2%;
    right: -4%;
    padding: 12px 18px;
    border: var(--line-w) solid #1a1613;
    border-radius: 18px 18px 18px 4px;
    background: #fffaf2;
    color: #1a1613;
    font-family: var(--display);
    font-size: 24px;
    font-weight: 800;
    line-height: 1;
    text-transform: uppercase;
    box-shadow: 5px 5px 0 #1a1613;
    --reveal-rot: 8deg;
  }

  .sticker {
    --rot: -6deg;
    position: absolute;
    padding: 8px 16px;
    border: var(--line-w) solid #1a1613;
    border-radius: 999px;
    color: #1a1613;
    font-family: var(--display);
    font-size: 21px;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    white-space: nowrap;
    box-shadow: 4px 4px 0 #1a1613;
    translate: 0 var(--py, 0px);
  }

  @media (prefers-reduced-motion: no-preference) {
    .sticker {
      animation: float 6s ease-in-out infinite;
    }
  }

  .tone-sun {
    background: var(--sun);
  }

  .tone-mint {
    background: var(--mint);
  }

  .tone-pink {
    background: var(--pink);
  }

  .tone-card {
    background: #fffaf2;
  }

  .s1 {
    top: 18%;
    left: -10%;
  }

  .s2 {
    --rot: 5deg;
    bottom: 22%;
    left: -14%;
    animation-delay: -2s;
  }

  .s3 {
    --rot: -4deg;
    bottom: 4%;
    right: -2%;
    animation-delay: -4s;
  }

  .s4 {
    --rot: 7deg;
    top: 40%;
    right: -12%;
    animation-delay: -1s;
  }

  @keyframes bob {
    0%,
    100% {
      transform: translateY(0) rotate(-2deg);
    }

    50% {
      transform: translateY(-12px) rotate(2deg);
    }
  }

  @media (max-width: 860px) {
    .hero-in {
      grid-template-columns: 1fr;
    }

    .art {
      order: -1;
      width: min(78%, 360px);
      margin-top: 16px;
    }

    .s1 {
      left: -16%;
    }

    .s4 {
      right: -16%;
    }
  }

  @media (max-width: 560px) {
    .hero-body {
      display: none;
    }

    .hero-lead {
      margin-top: 20px;
      font-size: 24px;
    }

    .sticker {
      font-size: 16px;
      padding: 6px 12px;
    }

    .bubble {
      font-size: 18px;
      right: -8%;
    }
  }
</style>
