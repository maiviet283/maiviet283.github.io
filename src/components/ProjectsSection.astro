---
import SectionHead from './SectionHead.astro'
import ProjectList from './ProjectList.astro'
import type { Locale } from '../types'

interface Props {
  text: Locale
  num: number
}

const { text, num } = Astro.props
---

<section class="section wrap" id="projects" aria-labelledby="projects-title">
  <SectionHead num={num} eyebrow={text.projects.eyebrow} title={text.projects.title} id="projects-title" />
  <ProjectList items={text.projects.items} githubLabel={text.projects.openGithub} />
  <p class="more" data-reveal>
    <a class="btn btn-blue" href="/projects/">
      {text.projects.viewAll}
      <svg class="arrow" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
    </a>
  </p>
</section>

<style>
  .more {
    margin-top: 32px;
  }
</style>
