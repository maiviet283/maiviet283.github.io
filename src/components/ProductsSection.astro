---
import Icon from './Icon.astro'
import ProductFeature from './ProductFeature.astro'
import ProductStatus from './ProductStatus.astro'
import SectionHead from './SectionHead.astro'
import type { Locale } from '../types'

interface Props {
  text: Locale
  num: number
}

const { text, num } = Astro.props
const products = text.products
const [featured, ...rest] = products.items
const tones = ['mint', 'sun', 'tomato']
---

<section class="section wrap" id="products" aria-labelledby="products-title">
  <SectionHead num={num} eyebrow={products.eyebrow} title={products.title} id="products-title" />

  <ProductFeature product={featured} labels={products} compact />

  <ul class="cards" data-reveal-group>
    {rest.map((product, index) => {
      const external = product.link.href.startsWith('http')
      const ended = product.status === 'ended'
      return (
        <li class:list={['pcard', 'card', 'lift', `tone-${tones[index]}`, { 'is-ended': ended }]} style={`--i: ${index}; --hover-rot: ${index % 2 ? 1 : -1}deg`}>
          <div class="pc-head">
            <ProductStatus status={product.status} label={products.status[product.status as keyof typeof products.status]} />
            <span class="period">{product.period}</span>
          </div>
          <div class="pc-body">
            <h3>
              <a href={`/projects/#product-${product.key}`}>{product.name}</a>
            </h3>
            <p class="tagline">{product.tagline}</p>
            <dl class="nums">
              {product.metrics.slice(0, 3).map((metric) => (
                <div>
                  <dt>{metric.label}</dt>
                  <dd>{metric.value}</dd>
                </div>
              ))}
            </dl>
            <div class="foot">
              <span class="role">{product.role}</span>
              <a
                class="text-link"
                href={product.link.href}
                target={external ? '_blank' : undefined}
                rel={external ? 'noreferrer' : undefined}
              >
                {product.link.label}
                <Icon name={external ? 'arrow-up-right' : 'arrow-right'} size={16} />
              </a>
            </div>
          </div>
          {ended ? <span class="stamp" aria-hidden="true">{products.status.ended}</span> : null}
        </li>
      )
    })}
  </ul>

  <p class="more" data-reveal>
    <a class="btn btn-blue" href="/projects/">
      <Icon name="grid" />
      {products.more}
    </a>
  </p>
</section>

<style>
  .cards {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(20px, 3vw, 32px);
    margin-top: clamp(32px, 4vw, 48px);
  }

  .pcard {
    position: relative;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .pc-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    padding: 16px 20px;
    border-bottom: var(--line);
    color: #1a1613;
  }

  .tone-mint .pc-head {
    background: var(--mint);
  }

  .tone-sun .pc-head {
    background: var(--sun);
  }

  .tone-tomato .pc-head {
    background: var(--tomato);
  }

  .period {
    font-family: var(--display);
    font-size: 16px;
    font-weight: 800;
    letter-spacing: 0.06em;
  }

  .pc-body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 12px;
    padding: 22px 22px 24px;
  }

  h3 {
    font-size: clamp(34px, 3.4vw, 44px);
    line-height: 0.92;
  }

  h3 a {
    background: linear-gradient(var(--sun), var(--sun)) 0 92% / 0 0.22em no-repeat;
    transition: background-size 300ms var(--ease-out);
  }

  @media (hover: hover) {
    .pcard:hover h3 a {
      background-size: 100% 0.22em;
    }
  }

  .tagline {
    font-weight: 700;
    line-height: 1.4;
  }

  .more {
    margin-top: clamp(28px, 4vw, 40px);
  }

  .nums {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: auto;
    padding-top: 6px;
  }

  .nums div {
    display: flex;
    flex-direction: column-reverse;
    padding: 8px 12px;
    border: 2px solid var(--ink);
    border-radius: 10px;
    background: var(--paper);
  }

  .nums dd {
    font-family: var(--display);
    font-size: 28px;
    font-weight: 800;
    line-height: 1;
    white-space: nowrap;
  }

  .nums dt {
    font-size: 12px;
    font-weight: 600;
    color: var(--muted);
  }

  .foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px 14px;
    padding-top: 14px;
    border-top: 2px dashed color-mix(in srgb, var(--ink) 30%, transparent);
  }

  .role {
    font-size: 13px;
    font-weight: 700;
    color: var(--muted);
  }

  .stamp {
    position: absolute;
    top: 74px;
    right: 14px;
    padding: 4px 12px;
    border: 4px solid var(--tomato-text);
    border-radius: 10px;
    color: var(--tomato-text);
    font-family: var(--display);
    font-size: 24px;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    rotate: 10deg;
    background: var(--card);
    pointer-events: none;
  }

  .is-ended h3 a {
    color: var(--muted);
  }

  @media (max-width: 960px) {
    .cards {
      grid-template-columns: 1fr;
    }
  }
</style>
