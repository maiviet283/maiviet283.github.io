---
import Mascot from './Mascot.astro'
import SocialIcon from './SocialIcon.astro'
import type { Locale } from '../types'

interface Props {
  text: Locale
  num: number
}

const { text, num } = Astro.props
const contact = text.contact
const email = contact.links.find((link) => link.href.startsWith('mailto:'))
const socials = contact.links.filter((link) => link !== email)
---

<section class="section wrap" id="contact" aria-labelledby="contact-title">
  <div class="panel card dots" data-reveal>
    <div class="copy">
      <div class="section-top">
        <span class="section-num" aria-hidden="true">{String(num).padStart(2, '0')}</span>
        <span class="label">{contact.eyebrow}</span>
      </div>
      <h2 id="contact-title">{contact.title}</h2>
      <p class="body">{contact.body}</p>
      {email ? (
        <a class="btn btn-sun btn-lg mail" href={email.href}>
          <SocialIcon name="email" />
          {contact.emailCta}
          <svg class="arrow" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
        </a>
      ) : null}
      {email ? <p class="address">{email.value}</p> : null}
    </div>

    <div class="side">
      <Mascot size="min(240px, 60vw)" alive class="wave" />
      <p class="label small">{contact.socialLabel}</p>
      <ul class="socials" data-reveal-group>
        {socials.map((link, index) => (
          <li style={`--i: ${index}`}>
            <a class="btn btn-sm social" href={link.href} target="_blank" rel="noreferrer" aria-label={`${link.label}: ${link.value}`}>
              <SocialIcon name={link.label} />
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .panel {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: clamp(28px, 5vw, 64px);
    padding: clamp(28px, 5vw, 64px);
    color: #fffaf2;
    box-shadow: var(--shadow-lg);
  }

  .copy {
    display: grid;
    align-content: start;
    gap: 18px;
  }

  .label {
    font-family: var(--display);
    font-size: 19px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  h2 {
    font-size: clamp(64px, 10vw, 136px);
    line-height: 0.86;
    text-shadow: 5px 5px 0 #1a1613;
  }

  .body {
    max-width: 44ch;
    font-size: 18px;
    color: rgb(255 250 242 / 0.9);
  }

  .mail {
    justify-self: start;
    margin-top: 6px;
    border-color: #1a1613;
    box-shadow: 5px 5px 0 #1a1613;
  }

  .address {
    font-size: 15px;
    font-weight: 600;
    color: rgb(255 250 242 / 0.85);
  }

  .side {
    display: grid;
    justify-items: center;
    align-content: center;
    gap: 16px;
  }

  .side :global(.wave) {
    box-shadow: 10px 10px 0 #1a1613;
  }

  @media (prefers-reduced-motion: no-preference) {
    .side :global(.wave) {
      animation: wave 3.6s ease-in-out infinite;
    }
  }

  .small {
    margin-top: 10px;
    font-size: 16px;
  }

  .socials {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
  }

  .social {
    border-color: #1a1613;
    box-shadow: 3px 3px 0 #1a1613;
    --bg: #fffaf2;
    --fg: #1a1613;
  }

  .social :global(svg) {
    width: 18px;
    height: 18px;
  }

  @keyframes wave {
    0%,
    60%,
    100% {
      rotate: 0deg;
    }

    70% {
      rotate: -8deg;
    }

    80% {
      rotate: 8deg;
    }

    90% {
      rotate: -4deg;
    }
  }

  @media (max-width: 860px) {
    .panel {
      grid-template-columns: 1fr;
    }
  }
</style>
