---
/** The toolbox as logo tiles, grouped on sticker cards. */
import Mascot from './Mascot.astro'
import SectionHead from './SectionHead.astro'
import TechTile from './TechTile.astro'
import type { Locale } from '../types'

interface Props {
  text: Locale
  num: number
  /** Show the "how I work" quote card (About page). */
  belief?: boolean
}

const { text, num, belief = false } = Astro.props
const stack = text.stack
const tones = ['sun', 'mint', 'pink', 'blue', 'tomato'] as const
---

<section class="section wrap" id="stack" aria-labelledby="stack-title">
  <SectionHead num={num} eyebrow={stack.eyebrow} title={stack.title} id="stack-title" />

  <div class="groups" data-reveal-group>
    {stack.groups.map((group, index) => (
      <section class="group card" aria-label={group.label}>
        <h3 class:list={['tag', `tone-${tones[index % tones.length]}`]}>{group.label}</h3>
        <ul class="tiles">
          {group.items.map((item) => <TechTile name={item} tone={tones[index % tones.length]} />)}
        </ul>
      </section>
    ))}
  </div>

  {belief ? (
    <figure class="belief card dots" data-reveal>
      <Mascot size={86} class="belief-mascot" />
      <div>
        <figcaption>{stack.beliefTitle}</figcaption>
        <blockquote><p>{stack.beliefBody}</p></blockquote>
      </div>
    </figure>
  ) : null}
</section>

<style>
  .groups {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: clamp(16px, 2.4vw, 24px);
  }

  .group {
    display: grid;
    align-content: start;
    gap: 18px;
    padding: 20px;
    grid-column: span 2;
  }

  .group:nth-child(4),
  .group:nth-child(5) {
    grid-column: span 3;
  }

  .tag {
    justify-self: start;
    padding: 4px 14px;
    border: var(--line);
    border-radius: 999px;
    color: #1a1613;
    font-size: 20px;
    letter-spacing: 0.06em;
    rotate: -3deg;
  }

  .tone-sun {
    background: var(--sun);
  }

  .tone-mint {
    background: var(--mint);
  }

  .tone-pink {
    background: var(--pink);
  }

  .tone-blue {
    background: var(--blue);
    color: #fffaf2;
  }

  .tone-tomato {
    background: var(--tomato);
    color: #fffaf2;
  }

  .tiles {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(74px, 1fr));
    gap: 16px 10px;
  }

  .belief {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 22px;
    align-items: center;
    margin-top: clamp(24px, 3vw, 36px);
    padding: clamp(22px, 3vw, 32px);
    color: #fffaf2;
  }

  .belief :global(.belief-mascot) {
    box-shadow: 5px 5px 0 #1a1613;
  }

  figcaption {
    display: inline-block;
    margin-bottom: 10px;
    padding: 2px 12px;
    border: var(--line-w) solid #1a1613;
    border-radius: 999px;
    background: var(--sun);
    color: #1a1613;
    font-family: var(--display);
    font-size: 18px;
    font-weight: 800;
    text-transform: uppercase;
  }

  blockquote p {
    font-size: clamp(16px, 1.6vw, 19px);
    font-weight: 600;
    line-height: 1.55;
  }

  @media (max-width: 960px) {
    .groups {
      grid-template-columns: 1fr 1fr;
    }

    .group,
    .group:nth-child(4),
    .group:nth-child(5) {
      grid-column: span 1;
    }

    .group:nth-child(5) {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 600px) {
    .groups {
      grid-template-columns: 1fr;
    }

    .group:nth-child(5) {
      grid-column: auto;
    }

    .group {
      padding: 16px;
    }

    .tiles {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 14px 6px;
    }

    .belief {
      grid-template-columns: 1fr;
    }
  }
</style>
