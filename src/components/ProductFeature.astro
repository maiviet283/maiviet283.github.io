---
/**
 * One product told in full: the story on a paper card, the spec sheet on a
 * dotted colour panel (role, period, numbers, stack, link).
 */
import Icon from './Icon.astro'
import ProductStatus from './ProductStatus.astro'
import type { Locale } from '../types'

type Products = Locale['products']
type Product = Products['items'][number]

interface Props {
  product: Product
  labels: Products
  headingLevel?: 'h2' | 'h3'
  tone?: 'blue' | 'tomato' | 'mint' | 'sun'
  /** Home page: story without the bullet points. */
  compact?: boolean
}

const { product, labels, headingLevel = 'h3', tone = 'blue', compact = false } = Astro.props
const Heading = headingLevel
const external = product.link.href.startsWith('http')
const ended = product.status === 'ended'
const endedOn = product.period.split('–').pop()?.trim()
---

<article class:list={['feature', 'card', `tone-${tone}`, { 'is-ended': ended }]} id={`product-${product.key}`} data-reveal>
  <div class="story">
    <div class="top">
      <ProductStatus status={product.status} label={labels.status[product.status as keyof typeof labels.status]} />
      <span class="period">{product.period}</span>
    </div>
    <Heading class="name">{product.name}</Heading>
    <p class="tagline">{product.tagline}</p>
    <p class="summary">{product.summary}</p>
    {compact ? null : (
      <ul class="points">
        {product.points.map((point) => (
          <li>
            <span class="tick"><Icon name="check" size={18} /></span>
            <span>{point}</span>
          </li>
        ))}
      </ul>
    )}
  </div>

  <aside class:list={['spec', { dots: tone === 'blue' }]} aria-label={`${product.name}: ${labels.roleLabel}, ${labels.stackLabel}`}>
    {ended ? <span class="stamp" aria-hidden="true">{labels.status.ended} · {endedOn}</span> : null}
    <p class="role"><span>{labels.roleLabel}</span>{product.role}</p>
    <dl class="metrics">
      {product.metrics.map((metric) => (
        <div>
          <dt>{metric.label}</dt>
          <dd>{metric.value}</dd>
        </div>
      ))}
    </dl>
    <ul class="stack" aria-label={labels.stackLabel}>
      {product.stack.map((item) => <li>{item}</li>)}
    </ul>
    <a
      class="btn btn-sun"
      href={product.link.href}
      target={external ? '_blank' : undefined}
      rel={external ? 'noreferrer' : undefined}
    >
      {product.link.label}
      <Icon name={external ? 'arrow-up-right' : 'arrow-right'} class="arrow" />
    </a>
  </aside>
</article>

<style>
  .feature {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
    overflow: hidden;
  }

  .story {
    display: grid;
    align-content: start;
    gap: 14px;
    padding: clamp(24px, 4vw, 48px);
  }

  .top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 14px;
  }

  .period {
    font-family: var(--display);
    font-size: 18px;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--muted);
  }

  .name {
    margin-top: 6px;
    font-size: clamp(48px, 8vw, 104px);
    line-height: 0.88;
    overflow-wrap: anywhere;
  }

  .tagline {
    font-family: var(--display);
    font-size: clamp(22px, 2.4vw, 28px);
    font-weight: 700;
    line-height: 1.15;
    text-transform: uppercase;
    color: var(--blue-text);
  }

  .tone-tomato .tagline {
    color: var(--tomato-text);
  }

  .summary {
    font-size: 17px;
    color: var(--ink-2);
  }

  .points {
    display: grid;
    gap: 10px;
    margin-top: 6px;
  }

  .points li {
    display: grid;
    grid-template-columns: 28px 1fr;
    gap: 10px;
    align-items: start;
    color: var(--ink-2);
  }

  .tick {
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    border: 2px solid var(--ink);
    border-radius: 8px;
    background: var(--mint);
    color: #1a1613;
  }

  /* ---------- Spec panel ---------- */
  .spec {
    position: relative;
    display: grid;
    align-content: start;
    gap: 18px;
    padding: clamp(24px, 3.4vw, 40px);
    border-left: var(--line);
    color: #fffaf2;
  }

  .tone-tomato .spec {
    background: var(--tomato);
  }

  .tone-mint .spec {
    background: var(--mint);
    color: #1a1613;
  }

  .tone-sun .spec {
    background: var(--sun);
    color: #1a1613;
  }

  .role {
    display: grid;
    gap: 2px;
    font-size: 18px;
    font-weight: 800;
    line-height: 1.3;
  }

  .role span {
    font-family: var(--display);
    font-size: 16px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    opacity: 0.8;
  }

  .metrics {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(110px, 1fr));
    gap: 12px;
  }

  .metrics div {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    padding: 12px 14px;
    border: var(--line-w) solid #1a1613;
    border-radius: 12px;
    background: #fffaf2;
    color: #1a1613;
    box-shadow: 4px 4px 0 #1a1613;
  }

  .metrics div:nth-child(2) {
    rotate: 2deg;
  }

  .metrics div:nth-child(3) {
    rotate: -2deg;
  }

  .metrics dd {
    font-family: var(--display);
    font-size: 38px;
    font-weight: 800;
    line-height: 1;
    white-space: nowrap;
  }

  .metrics dt {
    margin-top: 4px;
    font-size: 13px;
    font-weight: 600;
    line-height: 1.3;
    color: #4a423b;
  }

  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .stack li {
    padding: 2px 10px;
    border: 2px solid currentColor;
    border-radius: 999px;
    font-size: 13px;
    font-weight: 700;
  }

  .spec .btn {
    justify-self: start;
    border-color: #1a1613;
    box-shadow: 4px 4px 0 #1a1613;
  }

  .stamp {
    position: absolute;
    top: 18px;
    right: 18px;
    padding: 6px 14px;
    border: 4px solid #fffaf2;
    border-radius: 10px;
    color: #fffaf2;
    font-family: var(--display);
    font-size: 22px;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    rotate: 8deg;
    outline: 2px dashed rgb(255 250 242 / 0.6);
    outline-offset: 3px;
  }

  .is-ended .name {
    color: var(--muted);
  }

  @media (max-width: 860px) {
    .feature {
      grid-template-columns: minmax(0, 1fr);
    }

    .spec {
      border-left: 0;
      border-top: var(--line);
    }
  }
</style>
