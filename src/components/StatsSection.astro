---
/** Three big numbers on tilted stickers; the leading number counts up once in view. */
import type { Locale } from '../types'

interface Props {
  text: Locale
  lang: 'vi' | 'en'
}

const { text, lang } = Astro.props
const tones = ['sun', 'mint', 'pink']

const split = (value: string) => {
  const match = value.match(/^([\d.,]+)(.*)$/)
  if (!match) return { number: null, rest: value, grouped: false }
  const raw = match[1]
  // "6.000" / "6,000" are thousands; "1.2" is a decimal.
  const grouped = /^\d{1,3}([.,]\d{3})+$/.test(raw)
  const number = grouped ? Number(raw.replace(/[.,]/g, '')) : Number(raw.replace(',', '.'))
  return { number, rest: match[2], grouped }
}
---

<section class="stats wrap" aria-label={text.stats_title}>
  <ul class="grid" data-reveal-group>
    {text.stats.map((stat, index) => {
      const { number, rest, grouped } = split(stat.value)
      return (
        <li class:list={['stat', 'card', 'lift', `tone-${tones[index]}`]} style={`--i: ${index}; --tilt: ${index % 2 ? 2 : -2}deg`}>
          <strong class="value">
            {number === null ? (
              stat.value
            ) : (
              <><span data-count={number} data-grouped={grouped ? lang : undefined}>{stat.value.slice(0, stat.value.length - rest.length)}</span>{rest}</>
            )}
          </strong>
          <span class="label">{stat.label}</span>
        </li>
      )
    })}
  </ul>
</section>

<style>
  .stats {
    position: relative;
    z-index: 2;
    margin-top: -1px;
    padding-top: clamp(56px, 8vw, 96px);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(18px, 3vw, 32px);
  }

  .stat {
    --hover-rot: 0deg;
    display: grid;
    align-content: start;
    gap: 10px;
    padding: clamp(22px, 3vw, 32px);
    color: #1a1613;
    rotate: var(--tilt);
  }

  .tone-sun {
    background: var(--sun);
  }

  .tone-mint {
    background: var(--mint);
  }

  .tone-pink {
    background: var(--pink);
  }

  .value {
    font-family: var(--display);
    font-size: clamp(52px, 5.4vw, 80px);
    font-weight: 800;
    line-height: 0.92;
    font-variant-numeric: tabular-nums;
  }

  .label {
    max-width: 28ch;
    font-size: 16px;
    font-weight: 600;
    line-height: 1.45;
  }

  @media (max-width: 860px) {
    .grid {
      grid-template-columns: 1fr;
    }

    .stat {
      rotate: calc(var(--tilt) / 2);
    }
  }
</style>
