---
/** The round cartoon mark (src/lib/mascot.mjs) as an inline SVG. */
import { mascotSvg } from '../lib/mascot.mjs'

interface Props {
  size?: number | string
  label?: string
  class?: string
  /** Adds the hover wiggle and the head that follows the pointer. */
  alive?: boolean
}

const { size = 48, label = '', class: className, alive = false } = Astro.props
const id = Math.random().toString(36).slice(2, 8)
const dim = typeof size === 'number' ? `${size}px` : size
---

<span
  class:list={['mascot', className, { 'is-alive': alive }]}
  style={`--size: ${dim}`}
  data-mascot={alive ? '' : undefined}
  set:html={mascotSvg({ id, title: label })}
/>

<style>
  .mascot {
    display: inline-block;
    flex: none;
    width: var(--size);
    height: var(--size);
    border-radius: 50%;
  }

  .mascot :global(svg) {
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .mascot :global(.m-head) {
    transform-box: fill-box;
    transform-origin: 50% 90%;
    transform: rotate(var(--head-rot, 0deg)) translate(var(--head-x, 0px), var(--head-y, 0px));
    transition: transform 400ms var(--ease-out);
  }

  @media (prefers-reduced-motion: no-preference) {
    .mascot.is-alive :global(.m-eyes) {
      transform-box: fill-box;
      transform-origin: 50% 50%;
      animation: squint 4.2s ease-in-out infinite;
    }

    @media (hover: hover) {
      .mascot.is-alive:hover :global(svg) {
        animation: wiggle 500ms ease-in-out;
      }
    }
  }

  @keyframes squint {
    0%,
    92%,
    100% {
      transform: scaleY(1);
    }

    95% {
      transform: scaleY(0.55);
    }
  }
</style>
