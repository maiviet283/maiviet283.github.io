---
/**
 * Subpages (Vietnamese only): a coloured page header with breadcrumb
 * stickers, then the page body. Emits the BreadcrumbList JSON-LD.
 */
import Layout from './Layout.astro'
import text from '../localet/vi.json'
import { SITE } from '../lib/site'

interface Crumb {
  label: string
  href?: string
}

interface Props {
  title: string
  description: string
  keywords?: string
  path: string
  ogType?: string
  crumbLabel: string
  jsonLd?: object[]
  /** Page header content */
  eyebrow: string
  heading: string
  /** Header band colour */
  tone?: 'blue' | 'sun' | 'mint' | 'pink'
  noindex?: boolean
}

const { crumbLabel, jsonLd = [], eyebrow, heading, tone = 'blue', noindex = false, ...rest } = Astro.props
const canonical = `${SITE}${rest.path}`
const crumbs: Crumb[] = [{ label: 'Trang chủ', href: '/' }, { label: crumbLabel }]

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: crumbs.map((crumb, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: crumb.label,
    item: crumb.href ? `${SITE}${crumb.href}` : canonical,
  })),
}
---

<Layout lang="vi" text={text} noindex={noindex} jsonLd={noindex ? jsonLd : [breadcrumbJsonLd, ...jsonLd]} {...rest}>
  <header class:list={['page-head', `tone-${tone}`, { dots: tone === 'blue' }]}>
    <div class="wrap page-head-in">
      <nav class="crumbs" aria-label="Breadcrumb">
        <ol>
          {crumbs.map((crumb, index) => (
            <li>
              {crumb.href && index < crumbs.length - 1 ? (
                <a class="chip" href={crumb.href}>{crumb.label}</a>
              ) : (
                <span class="chip" aria-current="page">{crumb.label}</span>
              )}
            </li>
          ))}
        </ol>
      </nav>
      <p class="page-eyebrow" data-reveal>{eyebrow}</p>
      <h1 data-reveal style="--i: 1"><Fragment set:html={heading} /></h1>
      <div class="page-lead" data-reveal style="--i: 2"><slot name="lead" /></div>
      <slot name="head-extra" />
    </div>
  </header>

  <div class="page-body">
    <slot />
  </div>
</Layout>

<style>
  .page-head {
    border-bottom: var(--line);
    overflow: hidden;
  }

  .tone-blue {
    color: #fffaf2;
  }

  .tone-sun {
    background: var(--sun);
    color: #1a1613;
  }

  .tone-mint {
    background: var(--mint);
    color: #1a1613;
  }

  .tone-pink {
    background: var(--pink);
    color: #1a1613;
  }

  .page-head-in {
    position: relative;
    display: grid;
    gap: 18px;
    padding-block: clamp(36px, 6vw, 72px) clamp(48px, 7vw, 88px);
  }

  .crumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .crumbs .chip {
    color: #1a1613;
    background: #fffaf2;
    border-color: #1a1613;
  }

  .crumbs li + li {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .crumbs li + li::before {
    font-weight: 800;
    content: '→';
  }

  .crumbs a.chip {
    transition: transform 150ms ease-out;
  }

  @media (hover: hover) {
    .crumbs a.chip:hover {
      transform: rotate(-3deg);
    }
  }

  .page-eyebrow {
    font-family: var(--display);
    font-size: 20px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    opacity: 0.85;
  }

  h1 {
    max-width: 16ch;
    font-size: clamp(48px, 9vw, 112px);
    line-height: 0.92;
  }

  h1 :global(em) {
    display: inline-block;
    padding: 0 0.12em;
    border: var(--line-w) solid #1a1613;
    border-radius: 10px;
    background: var(--sun);
    color: #1a1613;
    font-style: normal;
    box-shadow: 4px 4px 0 #1a1613;
    transform: rotate(-2deg);
  }

  .tone-sun h1 :global(em) {
    background: #fffaf2;
  }

  .page-lead {
    max-width: 62ch;
    font-size: clamp(17px, 1.6vw, 20px);
    line-height: 1.6;
  }

  .page-lead :global(a) {
    font-weight: 700;
    text-decoration: underline;
    text-decoration-thickness: 3px;
    text-underline-offset: 4px;
    text-decoration-color: var(--sun);
  }

  .tone-sun .page-lead :global(a) {
    text-decoration-color: #1a1613;
  }

  .page-body {
    padding-block: clamp(56px, 8vw, 104px) clamp(72px, 10vw, 128px);
  }
</style>
