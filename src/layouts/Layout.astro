---
import '@fontsource/be-vietnam-pro/400.css'
import '@fontsource/be-vietnam-pro/500.css'
import '@fontsource/be-vietnam-pro/600.css'
import '@fontsource/be-vietnam-pro/700.css'
import '@fontsource/be-vietnam-pro/800.css'
import '@fontsource/barlow-condensed/700.css'
import '@fontsource/barlow-condensed/800.css'
import '../styles/global.css'
// Preload the display face: without it the giant headings render in the
// wider fallback for a beat and jump.
import barlowLatin from '@fontsource/barlow-condensed/files/barlow-condensed-latin-800-normal.woff2?url'
import barlowVi from '@fontsource/barlow-condensed/files/barlow-condensed-vietnamese-800-normal.woff2?url'

import Header from '../components/Header.astro'
import Mascot from '../components/Mascot.astro'
import Preloader from '../components/Preloader.astro'
import SiteFooter from '../components/SiteFooter.astro'
import { SITE } from '../lib/site'
import type { Locale } from '../types'

interface Props {
  lang: 'vi' | 'en'
  text: Locale
  title: string
  description: string
  path: string
  keywords?: string
  ogType?: string
  image?: string
  imageAlt?: string
  jsonLd?: object[]
  /** Home is the only bilingual route; only it declares the vi/en pair. */
  bilingual?: boolean
  /** Home uses in-page anchors in the nav and plays the opening moment. */
  isHome?: boolean
  noindex?: boolean
}

const {
  lang,
  text,
  title,
  description,
  path,
  keywords,
  ogType = 'website',
  image = '/og-image.png',
  imageAlt,
  jsonLd = [],
  bilingual = false,
  isHome = false,
  noindex = false,
} = Astro.props

const canonical = `${SITE}${path}`
const ogImage = image.startsWith('http') ? image : `${SITE}${image}`
const ogLocale = lang === 'en' ? 'en_US' : 'vi_VN'
const langHref = lang === 'en' ? '/' : '/en/'
---

<!doctype html>
<html lang={lang} data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Boot, before first paint: saved theme, the page-transition cover when
         arriving from another page here, and whether the opening moment plays
         (once per visit, never on internal navigation). -->
    <script is:inline>
      ;(function () {
        var root = document.documentElement
        root.classList.add('js')
        try {
          var theme = localStorage.getItem('theme')
          if (theme === 'dark' || theme === 'light') root.dataset.theme = theme
        } catch (e) {}
        try {
          if (sessionStorage.getItem('mv-wipe') === '1') {
            root.classList.add('wipe-in')
            sessionStorage.removeItem('mv-wipe')
          }
          var nav = performance.getEntriesByType && performance.getEntriesByType('navigation')[0]
          var reloaded = nav ? nav.type === 'reload' : false
          var internal = document.referrer.indexOf(location.origin + '/') === 0
          if ((internal || sessionStorage.getItem('mv-intro') === '1') && !reloaded) root.dataset.intro = 'seen'
          sessionStorage.setItem('mv-intro', '1')
        } catch (e) {}
      })()
    </script>

    <link rel="preload" href={barlowLatin} as="font" type="font/woff2" crossorigin />
    {lang === 'vi' ? <link rel="preload" href={barlowVi} as="font" type="font/woff2" crossorigin /> : null}

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#f5eee2" />

    <title>{title}</title>
    <meta name="description" content={description} />
    {keywords ? <meta name="keywords" content={keywords} /> : null}
    <meta name="author" content="Mai Quốc Việt" />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1'} />
    {noindex ? null : <link rel="canonical" href={canonical} />}

    {
      noindex ? null : bilingual ? (
        <>
          <link rel="alternate" hreflang="vi" href={`${SITE}/`} />
          <link rel="alternate" hreflang="en" href={`${SITE}/en/`} />
          <link rel="alternate" hreflang="x-default" href={`${SITE}/`} />
        </>
      ) : (
        <>
          <link rel="alternate" hreflang="vi" href={canonical} />
          <link rel="alternate" hreflang="x-default" href={canonical} />
        </>
      )
    }

    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt ?? title} />
    <meta property="og:locale" content={ogLocale} />
    {bilingual ? <meta property="og:locale:alternate" content={lang === 'en' ? 'vi_VN' : 'en_US'} /> : null}
    <meta property="og:site_name" content="Mai Quốc Việt – maiviet283.github.io" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:creator" content="@maiviet283" />

    <meta name="geo.region" content="VN-DN" />
    <meta name="geo.placename" content="Đà Nẵng, Việt Nam" />

    {jsonLd.map((schema) => <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />)}
  </head>
  <body>
    {isHome ? <Preloader name={text.brand.name} /> : null}

    <div class="wipe" aria-hidden="true">
      <span class="wipe-band"></span>
      <span class="wipe-band"></span>
      <span class="wipe-band">
        <span class="wipe-badge">
          <Mascot size={120} />
          <span>{text.meta.loading}</span>
        </span>
      </span>
    </div>

    <a class="skip-link" href="#main">{text.meta.skipToContent}</a>
    <div class="progress" aria-hidden="true"></div>

    <Header text={text} lang={lang} langHref={langHref} isHome={isHome} />

    <main id="main" tabindex="-1">
      <slot />
    </main>

    <SiteFooter text={text} lang={lang} />

    <a class="fab-top" href="#main" aria-label={text.meta.backToTop} title={text.meta.backToTop} data-to-top>
      <svg class="ring" viewBox="0 0 50 50" aria-hidden="true"><circle cx="25" cy="25" r="22"></circle></svg>
      <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
        <path d="M12 19V5M5.5 11.5 12 5l6.5 6.5" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>
    </a>

    <script>
      import '../scripts/motion'
    </script>
  </body>
</html>
