---
import PageLayout from '../../layouts/PageLayout.astro'
import ProductFeature from '../../components/ProductFeature.astro'
import ProjectList from '../../components/ProjectList.astro'
import SectionHead from '../../components/SectionHead.astro'
import text from '../../localet/vi.json'
import { SITE } from '../../lib/site'

const products = text.products
const projects = text.projects.items
const tones = ['blue', 'mint', 'sun', 'tomato'] as const

const itemListJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Sản phẩm và dự án của Mai Quốc Việt',
  itemListElement: [
    ...products.items.map((product) => ({
      '@type': 'SoftwareApplication',
      name: product.name,
      description: product.tagline,
      applicationCategory: 'BusinessApplication',
      url: product.link.href.startsWith('http') ? product.link.href : `${SITE}${product.link.href}`,
      author: { '@type': 'Person', name: 'Mai Quốc Việt' },
    })),
    ...projects.map((project) => ({
      '@type': 'SoftwareSourceCode',
      name: project.name,
      codeRepository: project.href,
      programmingLanguage: 'Python',
      author: { '@type': 'Person', name: 'Mai Quốc Việt' },
    })),
  ].map((item, index) => ({ '@type': 'ListItem', position: index + 1, item })),
}
---

<PageLayout
  title="Dự án – Haven, One Management System, EightyTwenty | Mai Quốc Việt"
  description="Sản phẩm và dự án của Mai Quốc Việt (maiviet283): Haven (bác sĩ tại nhà), One Management System (SaaS kế toán & thuế), EightyTwenty (chuỗi cà phê tại Úc), VietDon và các dự án mã nguồn. Django, React, PostgreSQL."
  path="/projects/"
  crumbLabel="Dự án"
  eyebrow="Dự án"
  heading="Sản phẩm mình xây <em>&amp;</em> vận hành"
  tone="sun"
  jsonLd={[itemListJsonLd]}
>
  <Fragment slot="lead">
    <p>
      Từ nền tảng sức khoẻ, SaaS kế toán cho doanh nghiệp nhỏ đến hệ thống cho chuỗi cà phê tại Úc —
      đây là những sản phẩm <a href="/about/">Mai Quốc Việt</a> đã thiết kế, ship và chạy production,
      cùng vài dự án mã nguồn dùng để rèn kỹ năng.
    </p>
  </Fragment>

  <section class="wrap block" aria-labelledby="products-title">
    <SectionHead num={1} eyebrow={products.eyebrow} title="Sản phẩm" id="products-title" />
    <div class="stack">
      {products.items.map((product, index) => (
        <ProductFeature product={product} labels={products} tone={tones[index % tones.length]} />
      ))}
    </div>
  </section>

  <section class="wrap block" aria-labelledby="oss-title">
    <SectionHead num={2} eyebrow={text.projects.eyebrow} title="Mã nguồn mở" id="oss-title" />
    <ProjectList items={projects} githubLabel="Xem trên GitHub" open />
  </section>
</PageLayout>

<style>
  .block {
    padding-bottom: clamp(56px, 8vw, 96px);
  }

  .stack {
    display: grid;
    gap: clamp(28px, 4vw, 48px);
  }
</style>
