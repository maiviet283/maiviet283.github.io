---
import PageLayout from '../../layouts/PageLayout.astro'
import SectionHead from '../../components/SectionHead.astro'
import { SITE } from '../../lib/site'

const webAppJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'VietDon',
  url: `${SITE}/vietdon/`,
  applicationCategory: 'FinanceApplication',
  operatingSystem: 'Web',
  description:
    'Nền tảng donate realtime cho streamer Việt Nam (02/2026 – 11/2026), đã dừng hoạt động. Thanh toán QR, alert realtime qua WebSocket.',
  inLanguage: 'vi',
  creator: { '@type': 'Person', name: 'Mai Quốc Việt', url: `${SITE}/` },
}

const numbers = [
  ['9 tháng', 'xây và vận hành'],
  ['200+', 'người dùng hoạt động'],
  ['~12 triệu ₫', 'doanh thu mỗi tháng'],
]

const steps = [
  {
    title: 'Creator lên kênh',
    body: 'Đăng ký, hoàn tất KYC, cấu hình trang donate và kết nối tài khoản ngân hàng nhận tiền.',
  },
  {
    title: 'Viewer donate nhanh',
    body: 'Không cần đăng nhập phức tạp: chọn số tiền và quét mã QR để thanh toán.',
  },
  {
    title: 'Alert hiện realtime',
    body: 'Giao dịch xác nhận xong là alert bật lên màn hình stream và dashboard doanh thu cập nhật ngay.',
  },
]

const engineering = [
  'Thanh toán QR qua Pay2s, xử lý giao dịch bất đồng bộ trên Celery.',
  'Alert donate realtime qua Django Channels và WebSocket.',
  'Redis cache cho các điểm nóng, media lưu trên Cloudflare R2.',
  'Deploy bằng Docker và Nginx.',
]

const tech = ['Django', 'DRF', 'React', 'PostgreSQL', 'Redis', 'Celery', 'Django Channels', 'Docker', 'Nginx']
const tones = ['sun', 'mint', 'pink']
---

<PageLayout
  title="VietDon – Nền tảng donate realtime cho streamer (2026, đã dừng) | Mai Quốc Việt"
  description="VietDon là nền tảng donate realtime cho streamer Việt Nam do Mai Quốc Việt (maiviet283) xây và vận hành từ 02/2026 đến 11/2026: 200+ người dùng hoạt động, thanh toán QR, alert realtime. Sản phẩm đã dừng hoạt động."
  path="/vietdon/"
  crumbLabel="VietDon"
  eyebrow="Lưu trữ · 02/2026 – 11/2026"
  heading="VietDon — donate realtime cho streamer <em>Việt</em>"
  tone="pink"
  jsonLd={[webAppJsonLd]}
>
  <Fragment slot="lead">
    <p>
      VietDon là sản phẩm cá nhân đầu tiên <a href="/about/">Mai Quốc Việt</a> xây và vận hành từ đầu
      đến cuối: giúp người xem ủng hộ streamer nhanh như mở app ngân hàng. Sau 9 tháng chạy thật,
      VietDon đã dừng hoạt động từ 11/2026. Trang này giữ lại như một ghi chép về sản phẩm.
    </p>
  </Fragment>
  <span slot="head-extra" class="stamp" aria-hidden="true">Đã dừng · 11/2026</span>

  <section class="wrap block">
    <SectionHead num={1} eyebrow="Con số" title="9 tháng chạy thật" />
    <ul class="nums" data-reveal-group>
      {numbers.map(([value, label], index) => (
        <li class:list={['card', 'lift', `tone-${tones[index]}`]}>
          <strong>{value}</strong>
          <span>{label}</span>
        </li>
      ))}
    </ul>
  </section>

  <section class="wrap block">
    <SectionHead num={2} eyebrow="Luồng sản phẩm" title="VietDon đã hoạt động thế nào" />
    <ol class="steps" data-reveal-group>
      {steps.map((step, index) => (
        <li class="card">
          <span class="step-num">{String(index + 1).padStart(2, '0')}</span>
          <h3>{step.title}</h3>
          <p>{step.body}</p>
        </li>
      ))}
    </ol>
  </section>

  <section class="wrap block">
    <SectionHead num={3} eyebrow="Kỹ thuật" title="Phía sau màn hình" />
    <div class="tech card" data-reveal>
      <ul class="points">
        {engineering.map((item) => <li>{item}</li>)}
      </ul>
      <ul class="chips">
        {tech.map((item) => <li class="chip">{item}</li>)}
      </ul>
    </div>
    <div class="cta" data-reveal>
      <a class="btn btn-sun btn-lg" href="/projects/">Sản phẩm hiện tại</a>
      <a class="btn btn-lg" href="/">Về trang chủ</a>
    </div>
  </section>
</PageLayout>

<style>
  .stamp {
    position: absolute;
    right: 0;
    bottom: clamp(40px, 7vw, 88px);
    padding: 8px 18px;
    border: 5px solid #c0331d;
    border-radius: 12px;
    background: #fffaf2;
    color: #c0331d;
    font-family: var(--display);
    font-size: clamp(26px, 3.4vw, 40px);
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    rotate: -10deg;
    box-shadow: 6px 6px 0 #1a1613;
  }

  .block {
    padding-bottom: clamp(56px, 8vw, 96px);
  }

  .nums,
  .steps {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(18px, 3vw, 28px);
  }

  .nums li {
    display: grid;
    gap: 6px;
    padding: clamp(22px, 3vw, 30px);
    color: #1a1613;
  }

  .nums strong {
    font-family: var(--display);
    font-size: clamp(48px, 6vw, 72px);
    font-weight: 800;
    line-height: 0.95;
  }

  .nums span {
    font-weight: 600;
  }

  .tone-sun {
    background: var(--sun);
  }

  .tone-mint {
    background: var(--mint);
  }

  .tone-pink {
    background: var(--pink);
  }

  .steps li {
    display: grid;
    align-content: start;
    gap: 10px;
    padding: 24px;
  }

  .step-num {
    display: grid;
    justify-self: start;
    place-items: center;
    width: 52px;
    height: 52px;
    border: var(--line);
    border-radius: 50%;
    background: var(--sun);
    color: #1a1613;
    font-family: var(--display);
    font-size: 24px;
    font-weight: 800;
  }

  .steps h3 {
    font-size: 32px;
  }

  .steps p {
    color: var(--ink-2);
  }

  .tech {
    display: grid;
    gap: 20px;
    padding: clamp(22px, 3vw, 32px);
  }

  .points {
    display: grid;
    gap: 10px;
    font-size: 18px;
  }

  .points li {
    position: relative;
    padding-left: 26px;
  }

  .points li::before {
    position: absolute;
    top: 0.5em;
    left: 0;
    width: 12px;
    height: 12px;
    border: 2px solid var(--ink);
    border-radius: 3px;
    background: var(--tomato);
    content: '';
    rotate: 45deg;
  }

  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 40px;
  }

  @media (max-width: 860px) {
    .nums,
    .steps {
      grid-template-columns: 1fr;
    }

    .stamp {
      position: relative;
      right: auto;
      bottom: auto;
      justify-self: start;
      margin-top: 8px;
    }
  }
</style>
