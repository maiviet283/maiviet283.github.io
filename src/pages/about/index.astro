---
import { Image } from 'astro:assets'
import PageLayout from '../../layouts/PageLayout.astro'
import Mascot from '../../components/Mascot.astro'
import SectionHead from '../../components/SectionHead.astro'
import WorkSection from '../../components/WorkSection.astro'
import avatar from '../../data/images/avatar.png'
import text from '../../localet/vi.json'
import { aboutProfileJsonLd } from '../../lib/site'

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'Mai Quốc Việt là ai?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Mai Quốc Việt (maiviet283) là full-stack developer & team lead tại Đà Nẵng, chuyên Python, Django, FastAPI và React. Anh dẫn một team 3 kỹ sư tại BNH Digital (agency phần mềm tại Úc) và là co-founder & lead engineer của Haven — nền tảng bác sĩ khám tại nhà.',
      },
    },
    {
      '@type': 'Question',
      name: 'Mai Quốc Việt quê ở đâu?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Mai Quốc Việt sinh ra và lớn lên ở xã Kỳ Khang, huyện Kỳ Anh, tỉnh Hà Tĩnh, Việt Nam. Hiện anh sống và làm việc tại Đà Nẵng.',
      },
    },
    {
      '@type': 'Question',
      name: 'Mai Quốc Việt học trường gì?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Mai Quốc Việt học ngành An toàn thông tin & Mạng máy tính tại VKU – Trường Đại học Công nghệ Thông tin và Truyền thông Việt – Hàn (Đại học Đà Nẵng), khoá 2021 – 2026, mã sinh viên 21IT595, lớp 21NS, GPA 8.2/10.',
      },
    },
    {
      '@type': 'Question',
      name: 'Mai Quốc Việt đang làm dự án gì?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Hiện Mai Quốc Việt đang xây Haven — nền tảng bác sĩ khám tại nhà và chăm sóc sức khoẻ (havenmed.vn). Anh cũng đã xây One Management System (SaaS kế toán & thuế cho doanh nghiệp nhỏ) và EightyTwenty (hệ thống cho chuỗi cà phê 10 cửa hàng tại Úc).',
      },
    },
    {
      '@type': 'Question',
      name: 'VietDon còn hoạt động không?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Không. VietDon là nền tảng donate realtime cho streamer do Mai Quốc Việt xây và vận hành từ 02/2026, đạt 200+ người dùng hoạt động, và đã dừng hoạt động từ 11/2026.',
      },
    },
  ],
}

const facts = [
  ['Họ tên', 'Mai Quốc Việt'],
  ['Vai trò', 'Full-stack Developer & Team Lead'],
  ['Công việc', 'BNH Digital — agency phần mềm tại Úc, làm remote'],
  ['Sản phẩm', 'Haven (co-founder & lead engineer)'],
  ['Nơi ở', 'Đà Nẵng, Việt Nam'],
  ['Quê quán', 'Kỳ Khang, Kỳ Anh, Hà Tĩnh, Việt Nam'],
  ['Học vấn', 'VKU — Kỹ sư An toàn thông tin & Mạng máy tính, 2021 – 2026'],
  ['Mã sinh viên', '21IT595 — lớp 21NS'],
  ['GPA', '8.2/10'],
  ['Ngoại ngữ', 'Tiếng Anh B1 (VSTEP), làm việc hằng ngày với team tại Úc'],
]

const stack = text.stack.groups.flatMap((group) => group.items)
const story = [
  {
    tag: 'Quê quán',
    title: 'Kỳ Khang, Kỳ Anh, Hà Tĩnh',
    body: 'Mai Quốc Việt sinh ra và lớn lên ở xã Kỳ Khang, huyện Kỳ Anh, tỉnh Hà Tĩnh — vùng đất miền Trung nhiều nắng gió. Sau khi tốt nghiệp phổ thông, mình vào Đà Nẵng học đại học và gắn bó với thành phố này đến nay.',
  },
  {
    tag: 'Học vấn',
    title: 'VKU — An toàn thông tin & Mạng máy tính',
    body: 'Mình học ngành An toàn thông tin & Mạng máy tính tại VKU – Trường Đại học Công nghệ Thông tin và Truyền thông Việt – Hàn (Đại học Đà Nẵng), khoá 2021 – 2026, mã sinh viên 21IT595, lớp 21NS, GPA 8.2/10. Nền tảng bảo mật đó theo mình vào mọi hệ thống: phân quyền, 2FA, cô lập dữ liệu giữa các tenant và audit log.',
  },
  {
    tag: 'Công việc',
    title: 'Team lead tại BNH Digital',
    body: 'Mình dẫn một team 3 kỹ sư tại BNH Digital, agency phần mềm tại Úc. Trong 5 tháng, team ship 6 ứng dụng web và mobile lên production — với test tự động, CI và tài liệu OpenAPI trên mọi dự án.',
  },
  {
    tag: 'Sản phẩm',
    title: 'Từ VietDon đến Haven',
    body: 'Sản phẩm cá nhân đầu tiên của mình là VietDon — nền tảng donate realtime cho streamer, chạy 9 tháng với 200+ người dùng trước khi dừng vào 11/2026. Giờ mình là co-founder và lead engineer của Haven, nền tảng bác sĩ khám tại nhà.',
  },
]
const tones = ['sun', 'mint', 'pink', 'card']
---

<PageLayout
  title="Mai Quốc Việt – Full-stack Developer Đà Nẵng, quê Kỳ Anh, Hà Tĩnh | Giới thiệu"
  description="Giới thiệu Mai Quốc Việt (maiviet283) – Full-stack developer & team lead tại Đà Nẵng, quê Kỳ Khang, Kỳ Anh, Hà Tĩnh. Kỹ sư An toàn thông tin VKU (21IT595, lớp 21NS), team lead tại BNH Digital, co-founder Haven. Python, Django, FastAPI, React."
  keywords="Mai Quốc Việt, Mai Quoc Viet, maiviet283, Mai Quốc Việt Hà Tĩnh, Mai Quốc Việt Kỳ Anh, Mai Quốc Việt Kỳ Khang, Mai Quốc Việt VKU, Mai Quốc Việt 21IT595, Mai Quốc Việt Đà Nẵng, Mai Quốc Việt Haven, Mai Quốc Việt BNH Digital, full-stack developer Đà Nẵng"
  path="/about/"
  ogType="profile"
  crumbLabel="Giới thiệu"
  eyebrow="Giới thiệu"
  heading="Mai Quốc Việt — Full-stack Developer tại <em>Đà Nẵng</em>"
  jsonLd={[aboutProfileJsonLd, faqJsonLd]}
>
  <Fragment slot="lead">
    <p>
      Mình là Mai Quốc Việt (maiviet283), full-stack developer &amp; team lead tại Đà Nẵng,
      sinh ra ở Kỳ Khang, Kỳ Anh, Hà Tĩnh. Mình thiết kế, ship và vận hành hệ thống production
      từ đầu đến cuối với Python, Django, FastAPI và React. Hiện mình dẫn một team tại BNH Digital
      và đang xây <a href="/projects/#product-haven">Haven</a> — nền tảng bác sĩ khám tại nhà.
    </p>
  </Fragment>
  <figure slot="head-extra" class="portrait" data-reveal style="--reveal-rot: 6deg">
    <Image src={avatar} alt="Chân dung Mai Quốc Việt" widths={[320, 560]} sizes="(min-width: 960px) 300px, 220px" loading="eager" />
    <Mascot size={92} class="portrait-badge" />
  </figure>

  <section class="wrap block">
    <SectionHead num={1} eyebrow="Thông tin nhanh" title="Vài dòng về mình" />
    <dl class="facts" data-reveal-group>
      {facts.map(([label, value], index) => (
        <div class="fact card" style={`--i: ${index}`}>
          <dt>{label}</dt>
          <dd>{value}</dd>
        </div>
      ))}
    </dl>
  </section>

  <section class="wrap block">
    <SectionHead num={2} eyebrow="Câu chuyện" title="Mai Quốc Việt là ai?" />
    <ol class="story" data-reveal-group>
      {story.map((item, index) => (
        <li class:list={['card', 'lift', `tone-${tones[index]}`]} style={`--hover-rot: ${index % 2 ? 1 : -1}deg`}>
          <span class="tag">{item.tag}</span>
          <h3>{item.title}</h3>
          <p>{item.body}</p>
        </li>
      ))}
    </ol>
  </section>

  <WorkSection text={text} num={3} />

  <section class="wrap block">
    <SectionHead num={4} eyebrow="Công nghệ" title="Bộ đồ nghề" />
    <ul class="chips big" data-reveal-group>
      {stack.map((item) => <li class="chip">{item}</li>)}
    </ul>
    <div class="cta" data-reveal>
      <a class="btn btn-sun btn-lg" href="/projects/">Xem sản phẩm</a>
      <a class="btn btn-lg" href="/#contact">Liên hệ</a>
    </div>
  </section>
</PageLayout>

<style>
  .portrait {
    position: absolute;
    right: 0;
    bottom: clamp(32px, 6vw, 72px);
    width: clamp(220px, 24vw, 300px);
    padding: 10px 10px 44px;
    border: var(--line-w) solid #1a1613;
    border-radius: 6px;
    background: #fffaf2;
    box-shadow: 10px 10px 0 #1a1613;
    rotate: 4deg;
  }

  .portrait img {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    border: 2px solid #1a1613;
  }

  .portrait :global(.portrait-badge) {
    position: absolute;
    bottom: -30px;
    left: -30px;
    box-shadow: 5px 5px 0 #1a1613;
    rotate: -10deg;
  }

  .block {
    padding-bottom: clamp(64px, 8vw, 104px);
  }

  .facts {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
    gap: 16px;
  }

  .fact {
    padding: 16px 18px;
    box-shadow: var(--shadow-sm);
  }

  .fact dt {
    font-family: var(--display);
    font-size: 16px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--blue-text);
  }

  .fact dd {
    font-weight: 700;
    line-height: 1.4;
  }

  .story {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(18px, 3vw, 28px);
  }

  .story li {
    display: grid;
    align-content: start;
    gap: 12px;
    padding: clamp(22px, 3vw, 30px);
  }

  .tone-sun {
    background: var(--sun);
    color: #1a1613;
  }

  .tone-mint {
    background: var(--mint);
    color: #1a1613;
  }

  .tone-pink {
    background: var(--pink);
    color: #1a1613;
  }

  .tag {
    justify-self: start;
    padding: 2px 12px;
    border: 2px solid #1a1613;
    border-radius: 999px;
    background: #fffaf2;
    color: #1a1613;
    font-size: 13px;
    font-weight: 800;
  }

  .story h3 {
    font-size: clamp(30px, 3.2vw, 40px);
  }

  .story p {
    opacity: 0.88;
  }

  .chips.big .chip {
    padding: 6px 16px;
    font-size: 16px;
    box-shadow: var(--shadow-sm);
  }

  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 40px;
  }

  :global(.page-body) > :global(.work) {
    margin-bottom: clamp(64px, 8vw, 104px);
  }

  @media (min-width: 961px) {
    :global(.page-head-in) {
      padding-right: clamp(280px, 28vw, 360px);
    }
  }

  @media (max-width: 960px) {
    .portrait {
      position: relative;
      right: auto;
      bottom: auto;
      justify-self: end;
      margin-top: 12px;
    }
  }

  @media (max-width: 720px) {
    .story {
      grid-template-columns: 1fr;
    }
  }
</style>
